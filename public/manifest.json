{
  "manifest_version": 3,
  "name": "Shopee Affiliate AI Studio - Script & 8s Video",
  "version": "1.0.0",
  "description": "ดึงข้อมูลสินค้า Shopee คิดสคริปต์ AI และทำคลิปสั้น 8 วินาทีลง TikTok/Shorts อัตโนมัติ",
  "permissions": [
    "sidePanel",
    "activeTab",
    "storage",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://*.shopee.co.th/*",
    "https://*.shopeemobile.com/*",
    "https://translate.google.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "เปิด Shopee Affiliate AI Studio",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.shopee.co.th/*",
        "https://*.shopeemobile.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
